# Image and container names
IMAGE_NAME=locoman-vla-jazzy:latest
CONTAINER_NAME=locoman_vla_jazzy

# Fixed host directory containing all local repositories.
HOST_WORKSPACE=
CONTAINER_WORKSPACE=/workspace/locoman_vla_deploy

# Repository directory names below HOST_WORKSPACE.
LOCOMANIP_DIR=locomanipulation-teleop-isaaclab
MUSE_DIR=muse
UNITREE_DLS_DIR=unitree-ros2-dls
PIPER_DIR=piper-ros2-dls

# Host network interface connected to the robot-side network/router.
# Find it with: ip -br address
ROBOT_NET_IFACE=
ROS_DOMAIN_ID=42

# Static CycloneDDS discovery peers on the Go2's onboard network (colon-
# separated addresses). Disables multicast and uses this list instead — set
# to the same peers as docker/jetson/jetson.env.example so this machine can
# discover the Jetson's nodes without multicast. Leave empty to keep
# multicast discovery.
CYCLONEDDS_PEERS=

# Parallel jobs used by colcon.
COLCON_JOBS=4

# Keep enabled because run_controller_ros2.py currently opens a MuJoCo viewer.
ENABLE_X11=1

# Optional additional Jazzy workspaces inside the mounted tree, beyond the
# piper-ros2-dls submodule (which is built and sourced automatically). Use
# container paths separated by colons. Leave empty when none are needed.
# Example:
# EXTRA_ROS_WORKSPACES=/workspace/locoman_vla_deploy/teleop_ws
EXTRA_ROS_WORKSPACES=

# Optional real-time priority for run-controller. Keep 0 until normal deployment
# is verified. Valid range is normally 1-99.
CONTROLLER_RT_PRIORITY=0
