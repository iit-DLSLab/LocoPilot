#!/usr/bin/env bash
set -eo pipefail

# Robot-side (Jetson) workspace build: only the packages needed for the
# follower arm + camera stack, plus agx_arm_moveit (built for its config/
# xacro files only -- vla_arm_controllers.launch.py reuses its ros2_control
# URDF; move_group/rviz/warehouse are never launched on the robot). The dls2
# bridge packages in piper-ros2-dls are intentionally not built here — the
# canonical dls2_interface (built from unitree-ros2-dls on the laptop) is not
# part of this deployment.

source /opt/ros/jazzy/setup.bash
source /opt/deploy_venv/bin/activate

# The image's apt-get install layer removes /var/lib/apt/lists to keep the
# image small (see Dockerfile), so rosdep's apt calls below have no package
# index at container runtime until this refreshes it.
apt-get update

WORKSPACE_ROOT="${WORKSPACE_ROOT:-/workspace/locoman_vla_deploy}"
PIPER_DIR="${PIPER_DIR:-piper-ros2-dls}"
COLCON_JOBS="${COLCON_JOBS:-4}"

PIPER_ROOT="${PIPER_ROOT:-$WORKSPACE_ROOT/$PIPER_DIR}"
PIPER_WS="$PIPER_ROOT/ros2_ws"
MANIP_WS="$WORKSPACE_ROOT/ros2_ws"

# Packages required by the follower-side teleop stack (teleop-session robot).
PIPER_PACKAGES=(
    piper_sdk
    agx_arm_msgs
    agx_arm_description
    agx_arm_ctrl
    agx_arm_pd_g_controller
    agx_arm_moveit
)

for path in \
    "$PIPER_WS/src" \
    "$MANIP_WS/src/dls_ros2_manipulation"; do
    if [[ ! -e "$path" ]]; then
        echo "Required path not found: $path" >&2
        echo "Clone the repo with the piper-ros2-dls and dls_ros2_manipulation submodules initialized." >&2
        exit 1
    fi
done

if [[ "${1:-}" == "--clean" ]]; then
    echo "Removing existing Jazzy build artifacts..."
    rm -rf \
        "$PIPER_WS/build" "$PIPER_WS/install" "$PIPER_WS/log" \
        "$MANIP_WS/build" "$MANIP_WS/install" "$MANIP_WS/log"
fi

build_ws() {
    local ws="$1"
    shift
    echo
    echo "================================================================"
    echo "Building: $ws"
    echo "================================================================"
    cd "$ws"
    python3 -m colcon build \
        --symlink-install \
        --parallel-workers "$COLCON_JOBS" \
        "$@" \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
}

# 1. Piper arm workspace, restricted to the teleop packages (+ agx_arm_moveit,
# built for its config files only). rosdep runs with -r so unresolvable keys
# do not abort the build; the skipped keys are agx_arm_moveit exec_depends for
# move_group/rviz/warehouse, none of which the VLA stack launches on the robot
# -- only its config/ xacro files (via moveit_configs_utils, NOT skipped: the
# VLA controllers launch imports it to build the robot_description) are used.
(
    cd "$PIPER_WS"
    rosdep install \
        --from-paths src \
        --ignore-src -r -y --rosdistro jazzy \
        --skip-keys "dls2_interface moveit_ros_perception moveit_ros_move_group moveit_ros_visualization moveit_ros_warehouse moveit_simple_controller_manager moveit_planners moveit_kinematics warehouse_ros_mongo" \
        || true
)
# piper_sdk (setup.py points package_dir outside the package tree) and
# agx_arm_pd_g_controller (generate_parameter_library_py generates its
# *_parameters.py module during setup.py, after the symlink farm is created)
# both break under --symlink-install; build them plain first (see
# build-dls-workspaces for details).
(
    cd "$PIPER_WS"
    python3 -m colcon build --packages-select piper_sdk agx_arm_pd_g_controller \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
)
build_ws "$PIPER_WS" \
    --packages-select "${PIPER_PACKAGES[@]}" \
    --packages-skip piper_sdk agx_arm_pd_g_controller
source "$PIPER_WS/install/setup.bash"

# 2. DLS manipulation workspace (manipulation_demo_recorder / haptic
# teleoperation packages, discovered through ros2_ws/src symlink). Plain
# build: these packages use generate_parameter_library_py too.
(
    cd "$MANIP_WS"
    rosdep install \
        --from-paths src \
        --ignore-src -r -y --rosdistro jazzy \
        || true
    python3 -m colcon build \
        --parallel-workers "$COLCON_JOBS" \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
)
source "$MANIP_WS/install/setup.bash"

echo
echo "Jetson deployment workspaces built successfully."
echo "Deploy from the laptop with: docker/jetson/deploy-robot.sh"
