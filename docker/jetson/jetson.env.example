# Jetson (robot-side) deployment configuration.
# Copy to .env in this directory:  cp jetson.env.example .env
# Used both by the laptop-side scripts (install-robot.sh, deploy-robot.sh,
# which read it locally before ssh-ing) and by the robot-side scripts
# (build-image.sh, start.sh, run on the Jetson).

# Image and container names on the Jetson.
IMAGE_NAME=locoman-vla-jetson:latest
CONTAINER_NAME=locoman_vla_jetson

# Base image produced by jetson-containers on the robot (see docker/README.md).
BASE_IMAGE=ros:jazzy-ros-base

# How the laptop reaches the robot. Default Unitree Go2 factory setup.
ROBOT_HOST=192.168.123.18
ROBOT_USER=unitree

# Where this repository lives on the robot (cloned by install-robot.sh).
ROBOT_WORKSPACE=/home/unitree/locoman_vla_deploy
CONTAINER_WORKSPACE=/workspace/locoman_vla_deploy

# jetson-containers checkout on the robot (pre-requirement, already installed).
JETSON_CONTAINERS_DIR=/home/unitree/jetson-containers

# Robot network interface facing the router (find on the robot: ip -br addr).
ROBOT_NET_IFACE=eth0
ROS_DOMAIN_ID=42

# Parallel jobs used by colcon on the Jetson.
COLCON_JOBS=4

# Set the RealSense serial numbers of the two robot cameras.
# Find them on the robot with:  rs-enumerate-devices -s
# Leave empty to use the launch-file defaults in
# manipulation_demo_recorder/launch/two_realsense_cameras.launch.py.
GRIPPER_CAMERA_SERIAL=750612070733
WORLD_CAMERA_SERIAL=241222074910
